# Copie este arquivo para ".env" e ajuste se precisar.
# Nao coloque senhas reais aqui: este arquivo vai para o GitHub.

# Banco da clinica
CLINICA_DB_NAME=clinica_db
CLINICA_DB_USER=postgres
CLINICA_DB_PASSWORD=postgres
# Se voce ja tem um PostgreSQL instalado no PC usando a 5432, troque para 5434
CLINICA_DB_PORT=5432

# Banco do governo (API governamental simulada)
GOVERNO_DB_NAME=governo_db
GOVERNO_DB_USER=postgres
GOVERNO_DB_PASSWORD=postgres
GOVERNO_DB_PORT=5433

# Chave usada para assinar os tokens de login (JWT)
JWT_SECRET=troque-esta-chave

# Usado quando a API roda FORA do Docker (pelo VS Code)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinica_db
GOVERNO_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/governo_db
